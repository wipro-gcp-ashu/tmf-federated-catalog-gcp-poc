{
  "id": "res-spec-compute-002",
  "href": "/tmf-api/resourceCatalog/v4/resourceSpecification/res-spec-compute-002",
  "name": "ComputeFlavorSpec",
  "description": "Atomic Telco Cloud Compute / GKE Worker Node Pool Specification bound to Terraform IaC module",
  "version": "1.0",
  "lifecycleStatus": "Active",
  "@type": "LogicalResourceSpecification",
  "@baseType": "ResourceSpecification",
  "category": "CloudComputeInfrastructure",
  "resourceSpecCharacteristic": [
    {
      "name": "region",
      "description": "Target cloud deployment region",
      "valueType": "string",
      "configurable": true,
      "minCardinality": 1,
      "maxCardinality": 1,
      "resourceSpecCharacteristicValue": [
        { "isDefault": true, "value": "us-central1" }
      ]
    },
    {
      "name": "cpu_count",
      "description": "Allocated vCPU count per compute instance / node",
      "valueType": "integer",
      "configurable": true,
      "minCardinality": 1,
      "maxCardinality": 1,
      "resourceSpecCharacteristicValue": [
        { "isDefault": true, "value": 8 },
        { "isDefault": false, "value": 16 },
        { "isDefault": false, "value": 32 }
      ]
    },
    {
      "name": "ram_gb",
      "description": "Allocated memory in GiB",
      "valueType": "integer",
      "configurable": true,
      "minCardinality": 1,
      "maxCardinality": 1,
      "resourceSpecCharacteristicValue": [
        { "isDefault": true, "value": 32 },
        { "isDefault": false, "value": 64 },
        { "isDefault": false, "value": 128 }
      ]
    },
    {
      "name": "numa_nodes",
      "description": "NUMA node pinning count for ultra-low latency packet processing",
      "valueType": "integer",
      "configurable": true,
      "minCardinality": 0,
      "maxCardinality": 1,
      "resourceSpecCharacteristicValue": [
        { "isDefault": true, "value": 0 },
        { "isDefault": false, "value": 2 }
      ]
    },
    {
      "name": "dpdk_enabled",
      "description": "Enable DPDK user-space packet acceleration",
      "valueType": "boolean",
      "configurable": true,
      "resourceSpecCharacteristicValue": [
        { "isDefault": true, "value": false }
      ]
    },
    {
      "name": "worker_instances",
      "description": "Number of UPF worker instances / replicas",
      "valueType": "integer",
      "configurable": true,
      "resourceSpecCharacteristicValue": [
        { "isDefault": true, "value": 1 },
        { "isDefault": false, "value": 2 }
      ]
    },
    {
      "name": "iac_binding",
      "description": "Immutable binding to Cloud Studio / Terraform execution artifact",
      "valueType": "object",
      "configurable": false,
      "resourceSpecCharacteristicValue": [
        {
          "isDefault": true,
          "value": {
            "iac_engine": "terraform+helm",
            "module_source": "./iac/terraform",
            "helm_chart": "./iac/helm-upf-slice",
            "provider": "hashicorp/google ~> 5.30"
          }
        }
      ]
    }
  ]
}
